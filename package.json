{
  "name": "swipe-interaction",
  "version": "0.2.1",
  "description": "Reusable horizontal row swipe gestures for touch and pointer input",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react",
    "swipe",
    "gesture",
    "touch",
    "pointer",
    "list",
    "mobile"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chester-hill-solutions/swipe-interaction.git"
  },
  "bugs": {
    "url": "https://github.com/chester-hill-solutions/swipe-interaction/issues"
  },
  "homepage": "https://github.com/chester-hill-solutions/swipe-interaction#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gesture": {
      "types": "./dist/gesture.d.ts",
      "import": "./dist/gesture.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "verify:exports": "npm run build && node scripts/verify-node-import.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "prepublishOnly": "npm run verify:exports && npm test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.5"
  }
}
